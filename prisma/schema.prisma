generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Users ───────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String?
  avatar       String?
  role         String   @default("student") // "student" | "coach" | "admin"
  joinedAt     DateTime @default(now())

  // Student fields
  xp            Int       @default(0)
  currentStreak Int       @default(0)
  longestStreak Int       @default(0)
  lastTrainedAt DateTime?
  beltRank      String    @default("white") // "white" | "blue" | "purple" | "brown" | "black"

  // Relations
  classesAsCoach       ClassSession[]       @relation("CoachClasses")
  attendances          ClassAttendance[]
  skillProgress        StudentSkill[]
  feedPosts            FeedPost[]
  badges               UserBadge[]
  coachNotes           CoachNote[]          @relation("NotesForStudent")
  coachNotesWritten    CoachNote[]          @relation("NotesFromCoach")
  trainingLogs         TrainingLog[]
  beltPromotions       BeltPromotion[]      @relation("StudentPromotions")
  promotionsGiven      BeltPromotion[]      @relation("CoachPromotions")
  competitions         Competition[]
  challengesCreated    Challenge[]          @relation("ChallengeCreator")
  challengeEntries     ChallengeParticipant[]
}

// ─── Technique Taxonomy ──────────────────────────────────────────────

model Position {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  sortOrder   Int      @default(0)

  techniques Technique[]
}

model Technique {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  discipline  String   // "gi" | "nogi" | "wrestling" | "all"
  category    String   // "submission" | "sweep" | "pass" | "escape" | "takedown" | "throw" | "transition" | "control" | "defense"
  difficulty  String   @default("fundamental") // "fundamental" | "intermediate" | "advanced"
  videoUrl    String?
  sortOrder   Int      @default(0)

  position   Position @relation(fields: [positionId], references: [id])
  positionId String

  // Relations
  classItems          ClassTechnique[]
  studentSkills       StudentSkill[]
  milestoneItems      MilestoneTechnique[]
  templateTechniques  ClassTemplateTechnique[]
}

// ─── Milestones (Skill Progression) ─────────────────────────────────

model Milestone {
  id          String   @id @default(cuid())
  name        String   // "Explorer" | "Traveler" | "Navigator" | "Guide"
  slug        String   @unique
  description String?
  monthsMin   Int      // 0, 6, 12, 24
  monthsMax   Int?     // 6, 12, 24, null
  sortOrder   Int      @default(0)

  techniques MilestoneTechnique[]
}

model MilestoneTechnique {
  id          String    @id @default(cuid())
  milestone   Milestone @relation(fields: [milestoneId], references: [id])
  milestoneId String
  technique   Technique @relation(fields: [techniqueId], references: [id])
  techniqueId String

  @@unique([milestoneId, techniqueId])
}

// ─── Classes ─────────────────────────────────────────────────────────

model ClassSession {
  id         String   @id @default(cuid())
  date       DateTime
  discipline String   // "gi" | "nogi" | "wrestling"
  title      String?
  notes      String?
  warmup     String?
  drillNotes String?
  sparring   Boolean  @default(true)

  coach   User   @relation("CoachClasses", fields: [coachId], references: [id])
  coachId String

  templateId String?
  template   ClassTemplate? @relation(fields: [templateId], references: [id])

  techniques ClassTechnique[]
  attendees  ClassAttendance[]

  createdAt DateTime @default(now())
}

model ClassTechnique {
  id             String       @id @default(cuid())
  classSession   ClassSession @relation(fields: [classSessionId], references: [id])
  classSessionId String
  technique      Technique    @relation(fields: [techniqueId], references: [id])
  techniqueId    String

  @@unique([classSessionId, techniqueId])
}

model ClassAttendance {
  id             String       @id @default(cuid())
  classSession   ClassSession @relation(fields: [classSessionId], references: [id])
  classSessionId String
  user           User         @relation(fields: [userId], references: [id])
  userId         String
  checkedIn      Boolean      @default(true)

  @@unique([classSessionId, userId])
}

// ─── Class Templates ─────────────────────────────────────────────────

model ClassTemplate {
  id         String   @id @default(cuid())
  name       String
  discipline String
  warmup     String?
  notes      String?
  createdAt  DateTime @default(now())

  techniques ClassTemplateTechnique[]
  classes    ClassSession[]
}

model ClassTemplateTechnique {
  id         String        @id @default(cuid())
  template   ClassTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  templateId String
  technique  Technique     @relation(fields: [techniqueId], references: [id])
  techniqueId String

  @@unique([templateId, techniqueId])
}

// ─── Student Progress ────────────────────────────────────────────────

model StudentSkill {
  id          String   @id @default(cuid())
  user        User     @relation(fields: [userId], references: [id])
  userId      String
  technique   Technique @relation(fields: [techniqueId], references: [id])
  techniqueId String
  level       String   @default("exposed") // "exposed" | "drilling" | "sparring" | "proficient"
  notes       String?
  updatedAt   DateTime @updatedAt

  @@unique([userId, techniqueId])
}

// ─── Training Journal ────────────────────────────────────────────────

model TrainingLog {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  date      DateTime @default(now())
  title     String?
  content   String
  mood      String?  // "great" | "good" | "okay" | "tough" | "bad"
  energy    Int?     // 1-5
  tags      String?  // JSON array of tags
  createdAt DateTime @default(now())
}

// ─── Coach Notes ─────────────────────────────────────────────────────

model CoachNote {
  id        String   @id @default(cuid())
  content   String
  coach     User     @relation("NotesFromCoach", fields: [coachId], references: [id])
  coachId   String
  student   User     @relation("NotesForStudent", fields: [studentId], references: [id])
  studentId String
  createdAt DateTime @default(now())
}

// ─── Belt Promotions ─────────────────────────────────────────────────

model BeltPromotion {
  id        String   @id @default(cuid())
  student   User     @relation("StudentPromotions", fields: [studentId], references: [id])
  studentId String
  coach     User     @relation("CoachPromotions", fields: [coachId], references: [id])
  coachId   String
  fromBelt  String
  toBelt    String
  stripes   Int      @default(0)
  notes     String?
  date      DateTime @default(now())
  createdAt DateTime @default(now())
}

// ─── Competitions ────────────────────────────────────────────────────

model Competition {
  id           String   @id @default(cuid())
  user         User     @relation(fields: [userId], references: [id])
  userId       String
  name         String
  date         DateTime
  location     String?
  discipline   String   // "gi" | "nogi" | "both"
  weightClass  String?
  result       String?  // "gold" | "silver" | "bronze" | "loss" | "dq"
  wins         Int      @default(0)
  losses       Int      @default(0)
  submissionBy String?  // technique used to win
  submittedBy  String?  // technique lost to
  notes        String?
  gamePlan     String?
  createdAt    DateTime @default(now())
}

// ─── Challenges ──────────────────────────────────────────────────────

model Challenge {
  id          String   @id @default(cuid())
  title       String
  description String
  type        String   // "attendance" | "skill" | "custom"
  target      Int      // e.g. 5 classes, 3 new techniques
  startDate   DateTime
  endDate     DateTime
  creator     User     @relation("ChallengeCreator", fields: [creatorId], references: [id])
  creatorId   String
  badgeSlug   String?  // optional badge reward
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  participants ChallengeParticipant[]
}

model ChallengeParticipant {
  id          String   @id @default(cuid())
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  challengeId String
  user        User     @relation(fields: [userId], references: [id])
  userId      String
  progress    Int      @default(0)
  completed   Boolean  @default(false)
  joinedAt    DateTime @default(now())

  @@unique([challengeId, userId])
}

// ─── Social / Gamification ───────────────────────────────────────────

model FeedPost {
  id        String   @id @default(cuid())
  type      String   // "checkin" | "milestone" | "badge" | "note" | "challenge"
  content   String
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  metadata  String?  // JSON string for extra data
  createdAt DateTime @default(now())
}

model Badge {
  id          String @id @default(cuid())
  name        String @unique
  slug        String @unique
  description String
  icon        String // emoji or icon name
  criteria    String // JSON string describing how to earn
  category    String // "mat_time" | "skills" | "social" | "milestone"

  users UserBadge[]
}

model UserBadge {
  id       String   @id @default(cuid())
  user     User     @relation(fields: [userId], references: [id])
  userId   String
  badge    Badge    @relation(fields: [badgeId], references: [id])
  badgeId  String
  earnedAt DateTime @default(now())

  @@unique([userId, badgeId])
}
